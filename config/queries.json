{
  "_comment": [
    "Query plan for harvesting Tunisia-related cartographic records from Gallica (BnF).",
    "Every query is ANDed with (dc.type all \"carte\") by the harvester, so only",
    "cartographic documents are returned. 'label' groups the query, 'ambiguous' marks",
    "toponyms that also exist outside Tunisia (Beja/Portugal, Monastir/Balkans, ...);",
    "records matched only by an ambiguous term and carrying no other Tunisian signal",
    "are scored 'low' confidence rather than dropped."
  ],
  "type_filter": "dc.type all \"carte\"",
  "queries": [
    { "term": "tunisie",              "index": "gallica",    "label": "country",  "ambiguous": false },
    { "term": "tunisie",              "index": "dc.subject", "label": "country",  "ambiguous": false },
    { "term": "tunisie",              "index": "dc.title",   "label": "country",  "ambiguous": false },
    { "term": "tunisia",              "index": "gallica",    "label": "country",  "ambiguous": false },
    { "term": "regence de tunis",     "index": "gallica",    "label": "polity",   "ambiguous": false },
    { "term": "royaume de tunis",     "index": "gallica",    "label": "polity",   "ambiguous": false },
    { "term": "ifriqiya",             "index": "gallica",    "label": "polity",   "ambiguous": false },
    { "term": "afrique proconsulaire","index": "gallica",    "label": "antiquity","ambiguous": false },
    { "term": "byzacene",             "index": "gallica",    "label": "antiquity","ambiguous": false },
    { "term": "tunis",                "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "carthage",             "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "bizerte",              "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "ferryville",           "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "la goulette",          "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "porto farina",         "index": "gallica",    "label": "city",     "ambiguous": true  },
    { "term": "ghar el melh",         "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "sousse",               "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "sfax",                 "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "kairouan",             "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "mahdia",               "index": "gallica",    "label": "city",     "ambiguous": true  },
    { "term": "monastir",             "index": "gallica",    "label": "city",     "ambiguous": true  },
    { "term": "gabes",                "index": "gallica",    "label": "city",     "ambiguous": false },
    { "term": "tabarka",              "index": "gallica",    "label": "city",     "ambiguous": false },
