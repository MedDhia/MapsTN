{
 "_about": {
  "purpose": "The vocabulary used to find tribal annotation in this collection: the generic terms a French cartographer used to mark a tribe, and the tribe names these maps actually print.",
  "how_the_tribe_list_was_built": [
   "Bottom-up, from the sheets. Every name in `tribes` was read off a map in",
   "this collection and is recorded in config/tribal_labels_read.json with the",
   "pixel it was read at. This is deliberately not an ethnography of Tunisia:",
   "it is a list of what these maps annotate, which is a different and smaller",
   "thing. A tribe absent from the list may well be absent only from the maps.",
   "",
   "Spelling is the second reason to keep it bottom-up. One tribe is printed",
   "Khroumir, Kroumir, Krumir and Chromir across four sheets; Frechiche is also",
   "Fraichiche and Frechich; Ouled is O., Od., Oulad and Ouled. `variants` holds",
   "the spellings observed plus the obvious transliteration neighbours, all",
   "matched after stripping accents and collapsing whitespace."
  ],
  "marker_terms": "A French map marks a tribe in one of a few ways, and which one it uses is itself the finding - see docs/TRIBES.md. `generic_terms` lists them as regexes, applied to accent-stripped lowercase text.",
  "caution": "`generic_terms` is tuned for map faces and catalogue text, not for prose. 'population' and 'race' in particular fire on anything statistical, so the coding script treats them as weak signals and never as sufficient evidence on their own."
 },
 "generic_terms": {
  "tribe_word": "\\btribus?\\b|\\btribal(?:e|es|aux)?\\b|\\bfractions?\\b|\\bconfederations?\\b|\\barch\\b|\\bferkas?\\b",
  "ethnography": "\\bethnograph\\w*|\\bpeuplement\\b|\\brepartition des\\b|\\bhabitation rurale\\b|\\bgroupes? ethni\\w*",
  "nomadism": "\\bnomades?\\b|\\bsemi-nomades?\\b|\\bsedentaires?\\b|\\btranshuman\\w*|\\bcampements?\\b|\\bdouars?\\b|\\bmechtas?\\b|\\btentes\\b|\\bgourbis?\\b",
  "native_administration": "\\bcaidats?\\b|\\bcheikhats?\\b|\\bkhalifats?\\b|\\bannexes? des affaires indigenes\\b|\\baffaires indigenes\\b|\\bterritoires? militaires?\\b|\\bcontroles? civils?\\b",
  "colonial_person_terms": "\\bindigenes?\\b|\\bbedouins?\\b|\\braces?\\b|\\bpopulations?\\b",
  "lineage_prefix": "\\boule?d\\b|\\bolad\\b|\\bawlad\\b|\\bbeni\\b|\\bbni\\b|\\bait\\b|\\bouerghemma\\b"
 },
 "weak_terms": [
  "colonial_person_terms"
 ],
